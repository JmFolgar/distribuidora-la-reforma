Project FERRETERIA {
  database_type: 'PostgreSQL'
  Note: 'Sistema de gestión de pedidos, inventario y ventas'
}

Table FER_DEPARTAMENTO {
  DEP_ID_DEPARTAMENTO bigint [pk, increment]
  DEP_CODIGO varchar(10) [not null, unique]
  DEP_NOMBRE varchar(100) [not null, unique]
}

Table FER_MUNICIPIO {
  MUN_ID_MUNICIPIO bigint [pk, increment]
  MUN_ID_DEPARTAMENTO bigint [not null]
  MUN_CODIGO varchar(10) [not null]
  MUN_NOMBRE varchar(100) [not null]

  indexes {
    (MUN_ID_DEPARTAMENTO, MUN_CODIGO) [unique]
    (MUN_ID_DEPARTAMENTO, MUN_NOMBRE) [unique]
  }
}

Table FER_DIRECCION {
  DIR_ID_DIRECCION bigint [pk, increment]
  DIR_ID_MUNICIPIO bigint [not null]
  DIR_ZONA varchar(10)
  DIR_COLONIA varchar(120)
  DIR_CALLE varchar(120)
  DIR_AVENIDA varchar(120)
  DIR_NUMERO_CASA varchar(30)
  DIR_REFERENCIA varchar(300)
}

Table FER_USUARIO {
  USU_ID_USUARIO bigint [pk, increment]
  USU_ID_DIRECCION bigint
  USU_PRIMER_NOMBRE varchar(60) [not null]
  USU_SEGUNDO_NOMBRE varchar(60)
  USU_TERCER_NOMBRE varchar(60)
  USU_PRIMER_APELLIDO varchar(60) [not null]
  USU_SEGUNDO_APELLIDO varchar(60)
  USU_NOMBRE_USUARIO varchar(60) [not null, unique]
  USU_CORREO varchar(254) [not null, unique]
  USU_TELEFONO varchar(30)
  USU_CLAVE_HASH varchar(255) [not null]
  USU_ESTADO char(1) [not null, default: 'A']
  USU_INTENTOS_FALLIDOS integer [not null, default: 0]
  USU_FECHA_BLOQUEO timestamptz
  USU_ULTIMO_ACCESO timestamptz
  USU_FECHA_CREACION timestamptz [not null]
  USU_FECHA_MODIFICACION timestamptz [not null]
}

Table FER_ROL {
  ROL_ID_ROL bigint [pk, increment]
  ROL_NOMBRE varchar(60) [not null, unique]
  ROL_DESCRIPCION varchar(250) [not null]
  ROL_ESTADO char(1) [not null, default: 'A']
}

Table FER_PERMISO {
  PER_ID_PERMISO bigint [pk, increment]
  PER_CODIGO varchar(80) [not null, unique]
  PER_NOMBRE varchar(100) [not null]
  PER_MODULO varchar(60) [not null]
  PER_ACCION varchar(60) [not null]
  PER_DESCRIPCION varchar(250) [not null]
  PER_ESTADO char(1) [not null, default: 'A']

  indexes {
    (PER_MODULO, PER_ACCION) [unique]
  }
}

Table FER_USUARIO_ROL {
  URO_ID_USUARIO_ROL bigint [pk, increment]
  URO_ID_USUARIO bigint [not null]
  URO_ID_ROL bigint [not null]
  URO_FECHA_ASIGNACION timestamptz [not null]
  URO_FECHA_REVOCACION timestamptz
  URO_ESTADO char(1) [not null, default: 'A']

  indexes {
    (URO_ID_USUARIO, URO_ID_ROL) [unique]
  }
}

Table FER_ROL_PERMISO {
  RPE_ID_ROL_PERMISO bigint [pk, increment]
  RPE_ID_ROL bigint [not null]
  RPE_ID_PERMISO bigint [not null]
  RPE_FECHA_ASIGNACION timestamptz [not null]
  RPE_ESTADO char(1) [not null, default: 'A']

  indexes {
    (RPE_ID_ROL, RPE_ID_PERMISO) [unique]
  }
}

Table FER_CLIENTE {
  CLI_ID_CLIENTE bigint [pk, increment]
  CLI_ID_DIRECCION bigint
  CLI_TIPO_PERSONA varchar(10) [not null]
  CLI_NIT varchar(20)
  CLI_PRIMER_NOMBRE varchar(60)
  CLI_SEGUNDO_NOMBRE varchar(60)
  CLI_TERCER_NOMBRE varchar(60)
  CLI_PRIMER_APELLIDO varchar(60)
  CLI_SEGUNDO_APELLIDO varchar(60)
  CLI_RAZON_SOCIAL varchar(180)
  CLI_CORREO varchar(254)
  CLI_TELEFONO varchar(30)
  CLI_ESTADO char(1) [not null, default: 'A']
  CLI_FECHA_CREACION timestamptz [not null]
}

Table FER_PROVEEDOR {
  PRV_ID_PROVEEDOR bigint [pk, increment]
  PRV_ID_DIRECCION bigint [not null]
  PRV_NIT varchar(20) [not null, unique]
  PRV_RAZON_SOCIAL varchar(180) [not null]
  PRV_NOMBRE_CONTACTO varchar(180)
  PRV_CORREO varchar(254) [not null]
  PRV_TELEFONO varchar(30) [not null]
  PRV_ESTADO char(1) [not null, default: 'A']
  PRV_FECHA_CREACION timestamptz [not null]
}

Table FER_CATEGORIA {
  CAT_ID_CATEGORIA bigint [pk, increment]
  CAT_NOMBRE varchar(100) [not null, unique]
  CAT_DESCRIPCION varchar(250)
  CAT_ESTADO char(1) [not null, default: 'A']
}

Table FER_UNIDAD_MEDIDA {
  UME_ID_UNIDAD_MEDIDA bigint [pk, increment]
  UME_CODIGO varchar(20) [not null, unique]
  UME_NOMBRE varchar(80) [not null, unique]
  UME_ABREVIATURA varchar(15) [not null]
  UME_ESTADO char(1) [not null, default: 'A']
}

Table FER_PRODUCTO {
  PRO_ID_PRODUCTO bigint [pk, increment]
  PRO_ID_CATEGORIA bigint [not null]
  PRO_ID_UNIDAD_MEDIDA bigint [not null]
  PRO_CODIGO varchar(50) [not null, unique]
  PRO_NOMBRE varchar(150) [not null]
  PRO_DESCRIPCION varchar(500)
  PRO_PRECIO_COMPRA numeric(14,2) [not null, default: 0]
  PRO_PRECIO_VENTA numeric(14,2) [not null]
  PRO_PORCENTAJE_IMPUESTO numeric(5,2) [not null, default: 0]
  PRO_EXISTENCIA_MINIMA numeric(14,3) [not null, default: 0]
  PRO_ESTADO char(1) [not null, default: 'A']
  PRO_FECHA_CREACION timestamptz [not null]
  PRO_FECHA_MODIFICACION timestamptz [not null]
}

Table FER_COMPRA {
  COM_ID_COMPRA bigint [pk, increment]
  COM_ID_PROVEEDOR bigint [not null]
  COM_NUMERO_COMPRA varchar(40) [not null, unique]
  COM_FECHA_COMPRA timestamptz [not null]
  COM_FECHA_ESPERADA date
  COM_ESTADO varchar(20) [not null]
  COM_OBSERVACION varchar(500)
}

Table FER_DETALLE_COMPRA {
  DCO_ID_DETALLE_COMPRA bigint [pk, increment]
  DCO_ID_COMPRA bigint [not null]
  DCO_ID_PRODUCTO bigint [not null]
  DCO_CANTIDAD numeric(14,3) [not null]
  DCO_COSTO_UNITARIO numeric(14,2) [not null]
  DCO_PORCENTAJE_DESCUENTO numeric(5,2) [not null, default: 0]
  DCO_PORCENTAJE_IMPUESTO numeric(5,2) [not null, default: 0]

  indexes {
    (DCO_ID_COMPRA, DCO_ID_PRODUCTO) [unique]
  }
}

Table FER_RECEPCION {
  REC_ID_RECEPCION bigint [pk, increment]
  REC_ID_COMPRA bigint [not null]
  REC_NUMERO_RECEPCION varchar(40) [not null, unique]
  REC_FECHA_RECEPCION timestamptz [not null]
  REC_ESTADO varchar(20) [not null]
  REC_OBSERVACION varchar(500)
}

Table FER_DETALLE_RECEPCION {
  DRE_ID_DETALLE_RECEPCION bigint [pk, increment]
  DRE_ID_RECEPCION bigint [not null]
  DRE_ID_DETALLE_COMPRA bigint [not null]
  DRE_CANTIDAD_RECIBIDA numeric(14,3) [not null, default: 0]
  DRE_CANTIDAD_RECHAZADA numeric(14,3) [not null, default: 0]
  DRE_MOTIVO_RECHAZO varchar(300)

  indexes {
    (DRE_ID_RECEPCION, DRE_ID_DETALLE_COMPRA) [unique]
  }
}

Table FER_INVENTARIO {
  INV_ID_INVENTARIO bigint [pk, increment]
  INV_ID_PRODUCTO bigint [not null, unique]
  INV_EXISTENCIA_ACTUAL numeric(14,3) [not null, default: 0]
  INV_CANTIDAD_RESERVADA numeric(14,3) [not null, default: 0]
  INV_FECHA_ULTIMO_MOVIMIENTO timestamptz
  INV_VERSION integer [not null, default: 0]
}

Table FER_MOVIMIENTO_INVENTARIO {
  MOV_ID_MOVIMIENTO bigint [pk, increment]
  MOV_ID_INVENTARIO bigint [not null]
  MOV_ID_USUARIO bigint [not null]
  MOV_TIPO_MOVIMIENTO varchar(15) [not null]
  MOV_CANTIDAD numeric(14,3) [not null]
  MOV_EXISTENCIA_ANTERIOR numeric(14,3) [not null]
  MOV_EXISTENCIA_NUEVA numeric(14,3) [not null]
  MOV_FECHA_MOVIMIENTO timestamptz [not null]
  MOV_MODULO_ORIGEN varchar(40) [not null]
  MOV_ID_REGISTRO_ORIGEN bigint [not null]
  MOV_NUMERO_DOCUMENTO varchar(40)
  MOV_MOTIVO varchar(300)
}

Table FER_ALERTA_INVENTARIO {
  ALE_ID_ALERTA bigint [pk, increment]
  ALE_ID_MOVIMIENTO bigint [not null]
  ALE_ID_USUARIO_ATIENDE bigint
  ALE_TIPO_ALERTA varchar(30) [not null]
  ALE_MENSAJE varchar(300) [not null]
  ALE_EXISTENCIA_MINIMA numeric(14,3) [not null]
  ALE_FECHA_GENERACION timestamptz [not null]
  ALE_FECHA_ATENCION timestamptz
  ALE_ESTADO varchar(15) [not null]
}

Table FER_ESTADO_PEDIDO {
  EPE_ID_ESTADO_PEDIDO bigint [pk, increment]
  EPE_CODIGO varchar(30) [not null, unique]
  EPE_NOMBRE varchar(80) [not null]
  EPE_ORDEN integer [not null, unique]
  EPE_PERMITE_MODIFICAR boolean [not null, default: false]
  EPE_PERMITE_FACTURAR boolean [not null, default: false]
  EPE_ESTADO char(1) [not null, default: 'A']
}

Table FER_DESCUENTO {
  DES_ID_DESCUENTO bigint [pk, increment]
  DES_NOMBRE varchar(100) [not null]
  DES_TIPO varchar(15) [not null]
  DES_VALOR numeric(14,2) [not null]
  DES_REQUIERE_APROBACION boolean [not null, default: false]
  DES_FECHA_INICIO timestamptz [not null]
  DES_FECHA_FIN timestamptz [not null]
  DES_ESTADO char(1) [not null, default: 'A']
}

Table FER_PEDIDO {
  PED_ID_PEDIDO bigint [pk, increment]
  PED_ID_CLIENTE bigint [not null]
  PED_ID_ESTADO_PEDIDO bigint [not null]
  PED_ID_DESCUENTO bigint
  PED_NUMERO_PEDIDO varchar(40) [not null, unique]
  PED_FECHA_PEDIDO timestamptz [not null]
  PED_FECHA_REQUERIDA date
  PED_PORCENTAJE_DESCUENTO numeric(5,2) [not null, default: 0]
  PED_OBSERVACION varchar(500)
}

Table FER_DETALLE_PEDIDO {
  DPE_ID_DETALLE_PEDIDO bigint [pk, increment]
  DPE_ID_PEDIDO bigint [not null]
  DPE_ID_PRODUCTO bigint [not null]
  DPE_CANTIDAD numeric(14,3) [not null]
  DPE_PRECIO_UNITARIO numeric(14,2) [not null]
  DPE_PORCENTAJE_DESCUENTO numeric(5,2) [not null, default: 0]
  DPE_PORCENTAJE_IMPUESTO numeric(5,2) [not null, default: 0]

  indexes {
    (DPE_ID_PEDIDO, DPE_ID_PRODUCTO) [unique]
  }
}

Table FER_HISTORIAL_PEDIDO {
  HPE_ID_HISTORIAL_PEDIDO bigint [pk, increment]
  HPE_ID_PEDIDO bigint [not null]
  HPE_ID_ESTADO_ANTERIOR bigint
  HPE_ID_ESTADO_NUEVO bigint [not null]
  HPE_ID_USUARIO bigint [not null]
  HPE_FECHA_CAMBIO timestamptz [not null]
  HPE_OBSERVACION varchar(500)
}

Table FER_APROBACION {
  APR_ID_APROBACION bigint [pk, increment]
  APR_ID_PEDIDO bigint [not null]
  APR_ID_USUARIO_SOLICITA bigint [not null]
  APR_ID_USUARIO_AUTORIZA bigint
  APR_TIPO_APROBACION varchar(30) [not null]
  APR_VALOR_SOLICITADO numeric(14,2) [not null]
  APR_VALOR_PERMITIDO numeric(14,2) [not null]
  APR_ESTADO varchar(15) [not null]
  APR_FECHA_SOLICITUD timestamptz [not null]
  APR_FECHA_RESPUESTA timestamptz
  APR_OBSERVACION varchar(500)
}

Table FER_VENTA {
  VEN_ID_VENTA bigint [pk, increment]
  VEN_ID_PEDIDO bigint [not null, unique]
  VEN_NUMERO_FACTURA varchar(40) [not null, unique]
  VEN_FECHA_VENTA timestamptz [not null]
  VEN_ESTADO varchar(15) [not null]
  VEN_FECHA_FINALIZACION timestamptz
}

Table FER_DETALLE_VENTA {
  DVE_ID_DETALLE_VENTA bigint [pk, increment]
  DVE_ID_VENTA bigint [not null]
  DVE_ID_DETALLE_PEDIDO bigint [not null, unique]
  DVE_CANTIDAD numeric(14,3) [not null]
  DVE_PRECIO_UNITARIO numeric(14,2) [not null]
  DVE_COSTO_UNITARIO numeric(14,2) [not null]
  DVE_PORCENTAJE_DESCUENTO numeric(5,2) [not null, default: 0]
  DVE_PORCENTAJE_IMPUESTO numeric(5,2) [not null, default: 0]
}

Table FER_METODO_PAGO {
  MPA_ID_METODO_PAGO bigint [pk, increment]
  MPA_CODIGO varchar(30) [not null, unique]
  MPA_NOMBRE varchar(80) [not null, unique]
  MPA_REQUIERE_REFERENCIA boolean [not null, default: false]
  MPA_ESTADO char(1) [not null, default: 'A']
}

Table FER_PAGO {
  PAG_ID_PAGO bigint [pk, increment]
  PAG_ID_VENTA bigint [not null]
  PAG_ID_METODO_PAGO bigint [not null]
  PAG_NUMERO_PAGO varchar(40) [not null, unique]
  PAG_FECHA_PAGO timestamptz [not null]
  PAG_MONTO numeric(14,2) [not null]
  PAG_REFERENCIA varchar(100)
  PAG_ESTADO varchar(15) [not null]
  PAG_OBSERVACION varchar(500)
}

Table FER_PARAMETRO {
  PAR_ID_PARAMETRO bigint [pk, increment]
  PAR_ID_USUARIO_MODIFICA bigint [not null]
  PAR_CODIGO varchar(80) [not null, unique]
  PAR_NOMBRE varchar(120) [not null]
  PAR_VALOR varchar(500) [not null]
  PAR_TIPO_DATO varchar(15) [not null]
  PAR_DESCRIPCION varchar(300)
  PAR_ESTADO char(1) [not null, default: 'A']
  PAR_FECHA_MODIFICACION timestamptz [not null]
}

Table FER_SOLICITUD_CLAVE {
  SCL_ID_SOLICITUD bigint [pk, increment]
  SCL_ID_USUARIO bigint [not null]
  SCL_FECHA timestamptz [not null]
  SCL_ESTADO varchar(15) [not null, default: 'PENDIENTE']
}

Table FER_AUDITORIA {
  AUD_ID_AUDITORIA bigint [pk, increment]
  AUD_ID_USUARIO bigint [not null]
  AUD_FECHA_EVENTO timestamptz [not null]
  AUD_MODULO varchar(60) [not null]
  AUD_ACCION varchar(60) [not null]
  AUD_ENTIDAD varchar(80) [not null]
  AUD_ID_REGISTRO bigint [not null]
  AUD_VALOR_ANTERIOR jsonb
  AUD_VALOR_NUEVO jsonb
  AUD_DIRECCION_IP inet
  AUD_RESULTADO varchar(10) [not null]
  AUD_MENSAJE varchar(500)
}

Table FER_REPORTE {
  REP_ID_REPORTE bigint [pk, increment]
  REP_CODIGO varchar(50) [not null, unique]
  REP_NOMBRE varchar(120) [not null]
  REP_DESCRIPCION varchar(300) [not null]
  REP_ORIGEN_DATOS text [not null]
  REP_PERMITE_FECHAS boolean [not null, default: false]
  REP_ESTADO char(1) [not null, default: 'A']
}

Table FER_EJECUCION_REPORTE {
  ERE_ID_EJECUCION_REPORTE bigint [pk, increment]
  ERE_ID_REPORTE bigint [not null]
  ERE_ID_USUARIO bigint [not null]
  ERE_FECHA_EJECUCION timestamptz [not null]
  ERE_FILTROS jsonb
  ERE_FORMATO varchar(10) [not null]
  ERE_ESTADO varchar(15) [not null]
  ERE_RUTA_ARCHIVO text
  ERE_MENSAJE_ERROR varchar(500)
}

Ref: FER_MUNICIPIO.MUN_ID_DEPARTAMENTO > FER_DEPARTAMENTO.DEP_ID_DEPARTAMENTO
Ref: FER_DIRECCION.DIR_ID_MUNICIPIO > FER_MUNICIPIO.MUN_ID_MUNICIPIO
Ref: FER_USUARIO.USU_ID_DIRECCION > FER_DIRECCION.DIR_ID_DIRECCION
Ref: FER_USUARIO_ROL.URO_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
Ref: FER_USUARIO_ROL.URO_ID_ROL > FER_ROL.ROL_ID_ROL
Ref: FER_ROL_PERMISO.RPE_ID_ROL > FER_ROL.ROL_ID_ROL
Ref: FER_ROL_PERMISO.RPE_ID_PERMISO > FER_PERMISO.PER_ID_PERMISO
Ref: FER_CLIENTE.CLI_ID_DIRECCION > FER_DIRECCION.DIR_ID_DIRECCION
Ref: FER_PROVEEDOR.PRV_ID_DIRECCION > FER_DIRECCION.DIR_ID_DIRECCION
Ref: FER_PRODUCTO.PRO_ID_CATEGORIA > FER_CATEGORIA.CAT_ID_CATEGORIA
Ref: FER_PRODUCTO.PRO_ID_UNIDAD_MEDIDA > FER_UNIDAD_MEDIDA.UME_ID_UNIDAD_MEDIDA
Ref: FER_COMPRA.COM_ID_PROVEEDOR > FER_PROVEEDOR.PRV_ID_PROVEEDOR
Ref: FER_DETALLE_COMPRA.DCO_ID_COMPRA > FER_COMPRA.COM_ID_COMPRA
Ref: FER_DETALLE_COMPRA.DCO_ID_PRODUCTO > FER_PRODUCTO.PRO_ID_PRODUCTO
Ref: FER_RECEPCION.REC_ID_COMPRA > FER_COMPRA.COM_ID_COMPRA
Ref: FER_DETALLE_RECEPCION.DRE_ID_RECEPCION > FER_RECEPCION.REC_ID_RECEPCION
Ref: FER_DETALLE_RECEPCION.DRE_ID_DETALLE_COMPRA > FER_DETALLE_COMPRA.DCO_ID_DETALLE_COMPRA
Ref: FER_INVENTARIO.INV_ID_PRODUCTO - FER_PRODUCTO.PRO_ID_PRODUCTO
Ref: FER_MOVIMIENTO_INVENTARIO.MOV_ID_INVENTARIO > FER_INVENTARIO.INV_ID_INVENTARIO
Ref: FER_MOVIMIENTO_INVENTARIO.MOV_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
Ref: FER_ALERTA_INVENTARIO.ALE_ID_MOVIMIENTO > FER_MOVIMIENTO_INVENTARIO.MOV_ID_MOVIMIENTO
Ref: FER_ALERTA_INVENTARIO.ALE_ID_USUARIO_ATIENDE > FER_USUARIO.USU_ID_USUARIO
Ref: FER_PEDIDO.PED_ID_CLIENTE > FER_CLIENTE.CLI_ID_CLIENTE
Ref: FER_PEDIDO.PED_ID_ESTADO_PEDIDO > FER_ESTADO_PEDIDO.EPE_ID_ESTADO_PEDIDO
Ref: FER_PEDIDO.PED_ID_DESCUENTO > FER_DESCUENTO.DES_ID_DESCUENTO
Ref: FER_DETALLE_PEDIDO.DPE_ID_PEDIDO > FER_PEDIDO.PED_ID_PEDIDO
Ref: FER_DETALLE_PEDIDO.DPE_ID_PRODUCTO > FER_PRODUCTO.PRO_ID_PRODUCTO
Ref: FER_HISTORIAL_PEDIDO.HPE_ID_PEDIDO > FER_PEDIDO.PED_ID_PEDIDO
Ref: FER_HISTORIAL_PEDIDO.HPE_ID_ESTADO_ANTERIOR > FER_ESTADO_PEDIDO.EPE_ID_ESTADO_PEDIDO
Ref: FER_HISTORIAL_PEDIDO.HPE_ID_ESTADO_NUEVO > FER_ESTADO_PEDIDO.EPE_ID_ESTADO_PEDIDO
Ref: FER_HISTORIAL_PEDIDO.HPE_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
Ref: FER_APROBACION.APR_ID_PEDIDO > FER_PEDIDO.PED_ID_PEDIDO
Ref: FER_APROBACION.APR_ID_USUARIO_SOLICITA > FER_USUARIO.USU_ID_USUARIO
Ref: FER_APROBACION.APR_ID_USUARIO_AUTORIZA > FER_USUARIO.USU_ID_USUARIO
Ref: FER_VENTA.VEN_ID_PEDIDO - FER_PEDIDO.PED_ID_PEDIDO
Ref: FER_DETALLE_VENTA.DVE_ID_VENTA > FER_VENTA.VEN_ID_VENTA
Ref: FER_DETALLE_VENTA.DVE_ID_DETALLE_PEDIDO - FER_DETALLE_PEDIDO.DPE_ID_DETALLE_PEDIDO
Ref: FER_PAGO.PAG_ID_VENTA > FER_VENTA.VEN_ID_VENTA
Ref: FER_PAGO.PAG_ID_METODO_PAGO > FER_METODO_PAGO.MPA_ID_METODO_PAGO
Ref: FER_PARAMETRO.PAR_ID_USUARIO_MODIFICA > FER_USUARIO.USU_ID_USUARIO
Ref: FER_SOLICITUD_CLAVE.SCL_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
Ref: FER_AUDITORIA.AUD_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
Ref: FER_EJECUCION_REPORTE.ERE_ID_REPORTE > FER_REPORTE.REP_ID_REPORTE
Ref: FER_EJECUCION_REPORTE.ERE_ID_USUARIO > FER_USUARIO.USU_ID_USUARIO
